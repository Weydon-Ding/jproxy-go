# jproxy-go v0.1.0 environment

# Listen address.
ADDR=:8117

# Upstream indexers.
# In Docker on Windows/macOS, host.docker.internal can reach services on the host.
JACKETT_URL=http://127.0.0.1:9117
PROWLARR_URL=http://127.0.0.1:9696

# Search/result behavior.
MIN_COUNT=6
INDEXER_RESULT_CACHE_EXPIRES=15
RESULT_CACHE_MAX_ENTRIES=1000
CACHE_EXPIRES=4320
OFFSET_CACHE_MAX_ENTRIES=1000
HTTP_TIMEOUT_SECONDS=60

# SQLite formatter snapshot (disabled by default). When enabled, JPROXY_DB_PATH
# must reference a writable SQLite file. Migrations finish before the listener
# starts; the store stays open while serving. Do not run Java and Go writers at
# the same time. Formatter payload variables below are ignored, but *_ENABLED
# flags still control whether the corresponding formatter executes. Reload is Todo 5.
JPROXY_DB_ENABLED=false
JPROXY_DB_PATH=

# Admin API authentication. Enable only with a non-default secret of at least 32 bytes.
JPROXY_LOGIN_ENABLED=false
JPROXY_JWT_SECRET=
JPROXY_TOKEN_EXPIRES_MINUTES=60

# Radarr XML title formatting (Phase 1, disabled by default).
# When enabled, format and JSON rules must be valid at startup. Rules run by
# ascending priority (omitted means 0); equal priorities retain JSON order.
# validStatus is optional/enabled by default, 1 enables, and 0 disables a rule.
JPROXY_RADARR_FORMAT_ENABLED=false
JPROXY_RADARR_FORMAT={title} ({year}) [{resolution}]
JPROXY_RADARR_TITLE_CLEAN_REGEX=
JPROXY_RADARR_FORMAT_RULES=[{"token":"title","regex":"^(.+?)\\.\\d{4}.*$","replacement":"$1","priority":0,"validStatus":1},{"token":"year","regex":".*?(\\d{4}).*","replacement":"$1","priority":10,"validStatus":1},{"token":"resolution","regex":".*?(\\d{3,4}p).*","replacement":"$1","priority":20,"validStatus":1}]
# Optional static title records are only used by {cleanTitle} title rules.
JPROXY_RADARR_TITLES=[]

# Sonarr XML title formatting (static slice, disabled by default).
# Each {cleanTitle} title record requires mainTitle, title or cleanTitle, and
# seasonNumber. Sonarr and Radarr rule sets are deliberately independent.
JPROXY_SONARR_FORMAT_ENABLED=false
JPROXY_SONARR_FORMAT={title} {season} [{quality}]
JPROXY_SONARR_TITLE_CLEAN_REGEX=
JPROXY_SONARR_FORMAT_RULES=[{"token":"title","regex":"^{cleanTitle} season \\d+.*$","replacement":"","priority":0,"validStatus":1},{"token":"quality","regex":".*?(\\d{3,4}p).*","replacement":"$1","priority":10,"validStatus":1}]
JPROXY_SONARR_TITLES=[]
